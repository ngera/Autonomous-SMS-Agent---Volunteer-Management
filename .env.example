# ── Database (local Docker Compose) ──
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking_secret
POSTGRES_DB=booking_system

# ── Database (production — Supabase) ──
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# ── Supabase Auth ──
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Twilio SMS ──
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+15005550006

# ── Anthropic AI ──
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# ── Google Calendar (optional) ──
# GOOGLE_CREDENTIALS_JSON={"installed":{"client_id":"...","client_secret":"..."}}

# ── Email (optional) ──
# RESEND_API_KEY=re_xxxxxxxx

# ── App Settings ──
ENVIRONMENT=development

# When true, services/sms.py::send_sms returns a fake SID without calling
# Twilio. Useful for dev/test before per-tenant Twilio Subaccounts are set up.
# SMS_SUPPRESS=true
